<project name="com.jme3.gde.scenecomposer" default="netbeans" basedir=".">
    <description>Builds, tests, and runs the project com.jme3.gde.scenecomposer.</description>
    <import file="nbproject/build-impl.xml"/>

    <!-- One-time editor migration, shared by NetBeans Run and Gradle's Ant build.
         Run before the harness timestamp check; removed locale resources and old
         bytecode otherwise survive incremental packaging. User profiles are untouched. -->
    <target name="-sdk-editor-migration-check" depends="init">
        <available file="${build.dir}/sdk-editor-input-locale-v1.stamp"
                   property="sdk.editor.migration.complete"/>
    </target>
    <target name="-sdk-editor-migrate" depends="-sdk-editor-migration-check"
            unless="sdk.editor.migration.complete">
        <echo message="Refreshing editor module: input controls and SDK language resources."/>
        <delete file="${cluster}/${module.jar}" failonerror="true"/>
        <delete failonerror="true">
            <fileset dir="${build.classes.dir}" erroronmissingdir="false">
                <include name="**/EditorMessages*.class"/>
                <include name="**/EditorLabels*.properties"/>
                <include name="**/EditorUiStyle*.class"/>
                <include name="**/ComposerCameraController*.class"/>
                <include name="**/SceneComposerToolController*.class"/>
                <include name="**/SceneComposerTopComponent*.class"/>
                <include name="**/SceneViewerTopComponent*.class"/>
                <include name="**/SceneApplication*.class"/>
                <include name="**/ModelDetailTopComponent*.class"/>
                <include name="com/jme3/gde/core/util/Bundle.properties"/>
            </fileset>
        </delete>
    </target>
    <target name="up-to-date"
            depends="init,-sdk-editor-migrate,projectized-common.up-to-date"/>
    <target name="-sdk-editor-migration-complete" extensionOf="-post-jar">
        <mkdir dir="${build.dir}"/>
        <touch file="${build.dir}/sdk-editor-input-locale-v1.stamp"/>
    </target>
</project>
